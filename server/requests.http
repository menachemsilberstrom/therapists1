@baseUrl = http://localhost:5000
@email = test@example3.com
@password = 12345678

###############################################################
# System
###############################################################

### Health check
GET {{baseUrl}}/api/health

###############################################################
# Auth
###############################################################

### Register a new therapist (201 + token, account starts PENDING_APPROVAL and hidden; run twice to see 409)
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "fullName": "Test Therapist"
}

### Login (200 + token) - run this before the protected requests below
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Token from the last login, used by the protected requests
@token = {{login.response.body.token}}

### Login with a wrong password (expects 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### Register with a short password (expects 400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "short@example.com",
  "password": "123"
}

###############################################################
# Categories (public)
###############################################################

### List categories (use the "slug" values below)
GET {{baseUrl}}/api/categories

###############################################################
# My profile (therapist token required)
###############################################################

### Get my profile
GET {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}

### Update my profile (partial update; categories are slugs from /api/categories)
PUT {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "דנה כהן",
  "professionalTitle": "מטפלת רגשית וזוגית",
  "bio": "מטפלת עם ניסיון של 10 שנים בטיפול בחרדה, זוגיות והורות.",
  "city": "חיפה",
  "phone": "050-1234567",
  "whatsapp": "972501234567",
  "contactEmail": "dana@example.com",
  "categories": ["anxiety", "couples-therapy"]
}

### Update with an unknown category (expects 400)
PUT {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categories": ["does-not-exist"]
}

### Update without a token (expects 401)
PUT {{baseUrl}}/api/therapists/me
Content-Type: application/json

{
  "bio": "should fail"
}

###############################################################
# Public directory
###############################################################

### List therapists (default page 1, 12 per page)
# @name list
GET {{baseUrl}}/api/therapists

### Search by text (name / title / bio / city)
GET {{baseUrl}}/api/therapists?q=חיפה

### Filter by category slug
GET {{baseUrl}}/api/therapists?category=anxiety

### Search + category + pagination together
GET {{baseUrl}}/api/therapists?q=דנה&category=anxiety&page=1&limit=5

### Get one therapist by slug (uses the first result of the "list" request above)
GET {{baseUrl}}/api/therapists/{{list.response.body.items[0].slug}}

### Unknown slug (expects 404)
GET {{baseUrl}}/api/therapists/no-such-therapist

###############################################################
# Uploads (therapist token required)
# Put a real image next to this file (e.g. photo.jpg) and a PDF or image (e.g. certificate.pdf), or change the paths.
# Limits: 5MB, avatar = JPG/PNG/WEBP, certificate = PDF/JPG/PNG/WEBP. The real file bytes are checked, not the name.
###############################################################

### Upload / replace my profile picture (200; resized to a 512x512 WebP, EXIF stripped)
POST {{baseUrl}}/api/therapists/me/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------FormBoundary--

### Remove my profile picture (200)
DELETE {{baseUrl}}/api/therapists/me/avatar
Authorization: Bearer {{token}}

### Upload a certificate (201; private, only admins will be able to open it)
# @name addCertificate
POST {{baseUrl}}/api/therapists/me/certificates
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

תואר שני בעבודה סוציאלית קלינית
------FormBoundary
Content-Disposition: form-data; name="certificate"; filename="certificate.pdf"
Content-Type: application/pdf

< ./certificate.pdf
------FormBoundary--

### Delete my last uploaded certificate (200). Run "Upload a certificate" first.
DELETE {{baseUrl}}/api/therapists/me/certificates/{{addCertificate.response.body.certificates[0].id}}
Authorization: Bearer {{token}}

### Upload without a token (expects 401)
POST {{baseUrl}}/api/therapists/me/avatar
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------FormBoundary--

@baseUrl = http://localhost:5000
@email = test@example3.com
@password = 12345678

###############################################################
# System
###############################################################

### Health check
GET {{baseUrl}}/api/health

###############################################################
# Auth
###############################################################

### Register a new therapist (201 + token, account starts PENDING_APPROVAL and hidden; run twice to see 409)
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "fullName": "Test Therapist"
}

### Login (200 + token) - run this before the protected requests below
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Token from the last login, used by the protected requests
@token = {{login.response.body.token}}

### Login with a wrong password (expects 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### Register with a short password (expects 400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "short@example.com",
  "password": "123"
}

###############################################################
# Categories (public)
###############################################################

### List categories (use the "slug" values below)
GET {{baseUrl}}/api/categories

###############################################################
# My profile (therapist token required)
###############################################################

### Get my profile
GET {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}

### Update my profile (partial update; categories are slugs from /api/categories)
PUT {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "דנה כהן",
  "professionalTitle": "מטפלת רגשית וזוגית",
  "bio": "מטפלת עם ניסיון של 10 שנים בטיפול בחרדה, זוגיות והורות.",
  "city": "חיפה",
  "phone": "050-1234567",
  "whatsapp": "972501234567",
  "contactEmail": "dana@example.com",
  "categories": ["anxiety", "couples-therapy"],
  "gender": "FEMALE",
  "region": "NORTH",
  "acceptsOnline": true,
  "targetAudiences": ["ADULTS", "COUPLES"]
}

### Update with an unknown category (expects 400)
PUT {{baseUrl}}/api/therapists/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categories": ["does-not-exist"]
}

### Update without a token (expects 401)
PUT {{baseUrl}}/api/therapists/me
Content-Type: application/json

{
  "bio": "should fail"
}

###############################################################
# Public directory
###############################################################

### List therapists (default page 1, 12 per page)
# @name list
GET {{baseUrl}}/api/therapists

### Advanced filters (all optional, combine freely): category slugs are "any of", audience is "any of", the rest narrow (AND)
GET {{baseUrl}}/api/therapists?category=anxiety,trauma&gender=FEMALE&region=NORTH

### Filter by target audience (any of): CHILDREN, TEENS, ADULTS, COUPLES, PARENTS
GET {{baseUrl}}/api/therapists?audience=TEENS,COUPLES

### Only therapists who also treat online, in a given city (city = part of the name)
GET {{baseUrl}}/api/therapists?online=true&city=חיפה

### Everything together: keyword + categories + gender + region + city + audience + online, page 1 of 5
GET {{baseUrl}}/api/therapists?q=טראומה&category=trauma,youth&gender=FEMALE&region=CENTER&audience=ADULTS&online=true&page=1&limit=5

### Invalid filter value (expects 400)
GET {{baseUrl}}/api/therapists?gender=ALIEN

### Cities that currently have visible therapists, with counts (used for the search suggestions)
GET {{baseUrl}}/api/therapists/filter-options

### Search by text (name / title / bio / city)
GET {{baseUrl}}/api/therapists?q=חיפה

### Filter by category slug
GET {{baseUrl}}/api/therapists?category=anxiety

### Search + category + pagination together
GET {{baseUrl}}/api/therapists?q=דנה&category=anxiety&page=1&limit=5

### Get one therapist by slug (uses the first result of the "list" request above)
GET {{baseUrl}}/api/therapists/{{list.response.body.items[0].slug}}

### Unknown slug (expects 404)
GET {{baseUrl}}/api/therapists/no-such-therapist

###############################################################
# Uploads (therapist token required)
# Put a real image next to this file (e.g. photo.jpg) and a PDF or image (e.g. certificate.pdf), or change the paths.
# Limits: 5MB, avatar = JPG/PNG/WEBP, certificate = PDF/JPG/PNG/WEBP. The real file bytes are checked, not the name.
###############################################################

### Upload / replace my profile picture (200; resized to a 512x512 WebP, EXIF stripped)
POST {{baseUrl}}/api/therapists/me/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------FormBoundary--

### Remove my profile picture (200)
DELETE {{baseUrl}}/api/therapists/me/avatar
Authorization: Bearer {{token}}

### Upload a certificate (201; private, only admins will be able to open it)
# @name addCertificate
POST {{baseUrl}}/api/therapists/me/certificates
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="title"

תואר שני בעבודה סוציאלית קלינית
------FormBoundary
Content-Disposition: form-data; name="certificate"; filename="certificate.pdf"
Content-Type: application/pdf

< ./certificate.pdf
------FormBoundary--

### Delete my last uploaded certificate (200). Run "Upload a certificate" first.
DELETE {{baseUrl}}/api/therapists/me/certificates/{{addCertificate.response.body.certificates[0].id}}
Authorization: Bearer {{token}}

### Upload without a token (expects 401)
POST {{baseUrl}}/api/therapists/me/avatar
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------FormBoundary--

###############################################################
# Admin (ADMIN token required)
# Create the admin first: set ADMIN_EMAIL / ADMIN_PASSWORD in .env and run "npm run seed:admin".
# Then put the same e-mail and password in the two variables below (do not commit real credentials).
###############################################################
@adminEmail = you@yourdomain.com
@adminPassword = replace-with-the-admin-password

### Admin login (200 + token)
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Admin token from the last admin login
@adminToken = {{adminLogin.response.body.token}}

### Counters: pending / active / suspended / total
GET {{baseUrl}}/api/admin/stats
Authorization: Bearer {{adminToken}}

### Moderation queue: pending therapists, oldest first
# @name pendingList
GET {{baseUrl}}/api/admin/therapists?status=PENDING_APPROVAL&sort=oldest
Authorization: Bearer {{adminToken}}

### All therapists: search by name / e-mail / city / title, filter by status, paging
GET {{baseUrl}}/api/admin/therapists?q=חיפה&status=ACTIVE&page=1&limit=10
Authorization: Bearer {{adminToken}}

### Review one therapist (uses the first row of the "pendingList" request; ids are USER ids)
# @name adminDetail
GET {{baseUrl}}/api/admin/therapists/{{pendingList.response.body.items[0].id}}
Authorization: Bearer {{adminToken}}

### Approve (or reactivate): account becomes ACTIVE and the profile goes live
PATCH {{baseUrl}}/api/admin/therapists/{{pendingList.response.body.items[0].id}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "ACTIVE" }

### Suspend: profile hidden immediately, user locked out immediately
PATCH {{baseUrl}}/api/admin/therapists/{{pendingList.response.body.items[0].id}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "SUSPENDED" }

### View a private certificate (first certificate of the therapist above; the response is the file itself)
GET {{baseUrl}}/api/admin/therapists/{{pendingList.response.body.items[0].id}}/certificates/{{adminDetail.response.body.certificates[0].id}}/file
Authorization: Bearer {{adminToken}}

### Mark that certificate verified (shows the "certificates verified" badge on the public profile)
PATCH {{baseUrl}}/api/admin/therapists/{{pendingList.response.body.items[0].id}}/certificates/{{adminDetail.response.body.certificates[0].id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "isVerified": true }

### Delete a therapist PERMANENTLY (account + profile + files). confirmEmail must equal the account's e-mail.
### Replace the id and e-mail below before sending; a wrong e-mail is refused with 400 and deletes nothing.
DELETE {{baseUrl}}/api/admin/therapists/PUT-THE-USER-ID-HERE
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "confirmEmail": "the-account-email@example.com" }

### All categories, including deactivated ones, with usage counts
# @name adminCategories
GET {{baseUrl}}/api/admin/categories
Authorization: Bearer {{adminToken}}

### Add a category (slug: lowercase latin letters, digits, single hyphens; cannot be changed later)
POST {{baseUrl}}/api/admin/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "חרדה חברתית", "slug": "social-anxiety" }

### Rename the first category in the list
PATCH {{baseUrl}}/api/admin/categories/{{adminCategories.response.body[0].id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "שם חדש" }

### Deactivate it (hidden from the public filter and profiles; reactivate with isActive: true)
PATCH {{baseUrl}}/api/admin/categories/{{adminCategories.response.body[0].id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "isActive": false }

### Admin route with a therapist or no token (expects 403 / 401)
GET {{baseUrl}}/api/admin/stats
Authorization: Bearer {{token}}

# Keep the build context small and, above all, keep secrets and local data OUT of the image.

# Never copy these into an image
.env
.env.*
!.env.example
uploads/
*.docx

# Rebuilt inside the image
node_modules/
dist/

# Not needed to build or run the app
tests/
coverage/
vitest.config.ts
tsconfig.tests.json
requests.http
*.md
npm-debug.log*

# Docker's own files and version control
Dockerfile
.dockerignore
.git
.gitignore

    "test:watch": "vitest",
    "test:raw": "vitest run",
    "seed:prod": "node dist/scripts/seedCategories.js",
    "seed:admin:prod": "node dist/scripts/seedAdmin.js",
    "db:check:prod": "node dist/scripts/checkDb.js"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",

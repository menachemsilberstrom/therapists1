PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/therapists_directory
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# development | production | test. Production logs are JSON; development logs are colored.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in production)
#LOG_LEVEL=info

# Used only by "npm run seed:admin" (min 12 chars). Delete ADMIN_PASSWORD from .env after the admin exists.
#ADMIN_EMAIL=you@yourdomain.com
#ADMIN_PASSWORD=choose-a-long-unique-passphrase

# Uploaded files live here (relative to the server folder): public/ (avatars, served at /uploads) and private/ (certificates, never served).
#UPLOADS_DIR=uploads
